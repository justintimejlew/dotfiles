#!/bin/bash
set -euo pipefail

# Only applies to Fedora/SELinux hosts — not relevant inside the devcontainer itself
if ! command -v semanage >/dev/null 2>&1; then
    exit 0
fi

PROJECT_DIRS=("$HOME/.devpod" "$HOME/Documents/GitHub")

for DIR in "${PROJECT_DIRS[@]}"; do
  if [ -d "$DIR" ]; then
    if ! sudo semanage fcontext -l | grep -q "^${DIR}(/.*)\?.*container_file_t"; then
    sudo semanage fcontext -a -t container_file_t "${DIR}(/.*)?"
    fi
    sudo restorecon -Rv "$DEVPOD_WORKSPACES"
  fi
done
