# ~~~~~~~~~~~~~~~ History ~~~~~~~~~~~~~~~~~~~~

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt HIST_IGNORE_SPACE # do not save a command if it starts with a space
setopt HIST_IGNORE_DUPS  # do not save duplicate commands
setopt SHARE_HISTORY     # Share history between sessions

# ~~~~~~~~~~~~~~~ Environment Variables ~~~~~~

if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim > /dev/null ; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

export LANG="en_US.UTF-8"

# ~~~~~~~~~~~~~~~ Prompt ~~~~~~~~~~~~~~~~~~~~~

# enable zsh vi-mode
bindkey -e
export KEYTIMEOUT=1 # make switching between modes faster

# ~~~~~~~~~~~~~~~ Directories ~~~~~~~~~~~~~~~~

export REPOS="$HOME/Documents/GitHub/"
export GITUSER="justintimejlew"
export DOTFILES="$HOME/.local/share/chezmoi"
export HOMELAB="$REPOS/homelab"
export SCRIPTS="$DOTFILES/scripts"
export OBSIDIAN="$HOME/Documents/obsidian/second-brain"

# ~~~~~~~~~~~~~~~ Mise ~~~~~~~~~~~~~~~~~~~~~~~

if command -v mise > /dev/null ; then
  eval "$($HOME/.local/bin/mise activate zsh)"
fi

# ~~~~~~~~~~~~~~~ Homebrew ~~~~~~~~~~~~~~~~~~~

echo 'eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"'
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# ~~~~~~~~~~~~~~~ Path Configuration ~~~~~~~~~

setopt extended_glob null_glob

path=(
  $path
  $HOME/bin
  $HOME/.local/bin
  $SCRIPTS
  $HOME/.rd/bin
  /home/vscode/.local/bin
  /root/.local/bin
)

# Remove duplicate entries and non-existent Directories
typeset -U path
path=($^path(N-/))

export PATH

# ~~~~~~~~~~~~~~~ Starship ~~~~~~~~~~~~~~~~~~~

eval "$(starship init zsh)"

# ~~~~~~~~~~~~~~~ Completion ~~~~~~~~~~~~~~~~~

autoload -Uz compinit && compinit

if command -v fzf > /dev/null ; then
  source <(fzf --zsh)
fi

if command -v flux > /dev/null ; then
  source <(flux completion zsh)
fi

if command -v mise > /dev/null ; then
  source <(mise completion zsh)
fi

# ~~~~~~~~~~~~~~~ DevPods ~~~~~~~~~~~~~~~~~~~~

devpod-init() {
  mkdir -p .devcontainer
  cp "$HOME/.config/devpod/devcontainer.json" .devcontainer/devcontainer.json
  devpod up . --ide none --dotfiles https://github.com/justintimejlew/dotfiles.git
}

# ~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~~~

alias v=nvim
alias vim=nvim
alias vi=vim
alias gp="git pull"
alias gs="git status"
alias lg=lazygit
alias cls=clear

# Directories
alias scripts="cd $SCRIPTS"
alias skool='cd $REPOS/lab/kubernetes-fundamentals'
alias hl="cd $HOMELAB"
alias notes="cd \$OBSIDIAN"
alias chez="cd $DOTFILES"
alias nvs="cd ~/.local/state/nvim/swap"

if command -v bat > /dev/null ; then
  alias cat="bat"
fi

## bat on debian based systems is batcat.
if command -v batcat > /dev/null ; then
  alias cat="batcat"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la="ls -lathr"
  alias lla="ls -lgha"
  alias lt="ls --tree"
fi

# Kubernetes
export KUBECONFIG=~/.kube/config

if command -v kubectl > /dev/null ; then
  source <(kubectl completion zsh)
  alias k="kubectl"
  alias kgp="kubectl get pods"
fi

# DevPods
alias ds="devpod ssh"
alias dr="devpod up . --recreate"

# Bluetooth Connection
alias bth="bluetoothctl connect 84:9D:4B:1E:47:20"      # Connect Headphones
alias bthd="bluetoothctl disconnect 84:9D:4B:1E:47:20"  # Disconnect Headphones

alias bta="bluetoothctl connect 20:78:CD:75:EA:9F"      # Connect Airpods   
alias btad="bluetoothctl disconnect 20:78:CD:75:EA:9F"  # Disconnect Airpods
